{
  "name": "rderandom-studio",
  "productName": "RandomStudio",
  "version": "4.7.5",
  "description": "RandomStudio: gestor de contenido de RDeRandom (escritorio + web)",
  "private": true,
  "main": "electron/arranque.cjs",
  "scripts": {
    "extraer": "node tools/extraer.mjs",
    "icono": "node tools/icono.mjs",
    "dev": "vite",
    "build": "vite build",
    "publicar": "node tools/publicar.mjs",
    "app": "electron .",
    "dist": "electron-builder --win && node tools/instalar.mjs",
    "instalar": "node tools/instalar.mjs",
    "prebuild": "node tools/proyecto.mjs && node tools/chat.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jimp": "^0.22.12",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "build": {
    "appId": "com.rderandom.studio",
    "productName": "RandomStudio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json",
      "proyecto/**/*",
      "chat/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  }
}
